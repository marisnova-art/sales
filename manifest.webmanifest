  "orientation": "any",
  "background_color": "#E3E1DC",
  "theme_color": "#E3E1DC",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "실적 입력", "short_name": "실적", "url": "./#/actual?new=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "수익 항목", "short_name": "항목", "url": "./#/items", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "월별 계획", "short_name": "계획", "url": "./#/plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "분석", "short_name": "분석", "url": "./#/analytics", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
